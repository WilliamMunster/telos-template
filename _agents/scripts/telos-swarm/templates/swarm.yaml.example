# telos-swarm 配置示例
# 使用方式: telos-swarm start swarm.yaml

session: evidence-chain
project: ~/project/my-project
base_branch: main
worktree: true

# TL 配置（可选）
# 不指定 cli 则自动选择当前设备最强可用 CLI
tl:
  cli: claude
  use_team: true       # 允许 Claude TL 使用内置 team 功能

# 共享上下文，所有 agent 都能看到
context: |
  Your project description here.
  核心原则见 docs/architecture.md。
  遵循 closed-loop-first 和 evidence-driven 原则。

# 定义任务（不指定 CLI，由 TL 分配）
tasks:
  - id: model-design
    description: "设计 evidence chain 数据模型，创建 src/models/evidence.py"
    type: development

  - id: test-cases
    description: "为 evidence chain 写 pytest 测试用例，参考 tests/ 已有模式"
    type: development

  - id: research
    description: "调研 evidence chain 在可观测性平台中的最佳实践"
    type: research

# 可选：手动指定分配（覆盖 TL 的建议）
# assignments:
#   model-design: claude
#   test-cases: codex
#   research: gemini

# 质量门禁配置（可选，覆盖默认值）
# quality:
#   min_lines: 5              # 默认最低行数（coding 类型自动 ×2）
#   error_patterns: "^(I cannot |抱歉)"  # 自定义错误模式正则

# 归档配置（可选）
# archive:
#   target: work/personal/swarm-outputs  # 相对于 vault 的归档目录
#   auto: true                           # arena_complete 时自动归档
